# Data (large, and the real dataset shouldn't be committed - see docs/DATASET.md)
data/raw/*
data/processed/*
data/splits/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/splits/.gitkeep

# Trained model artifacts (large binary files - track via releases/DVC, not git)
models/v1/*.h5
models/v1/saved_model/
models/v1/*.index
models/v1/*.faiss

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# Notebooks
.ipynb_checkpoints/

# Env / secrets
.env
.kaggle/kaggle.json

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vercel/

# OS / editor
.DS_Store
.vscode/
.idea/
